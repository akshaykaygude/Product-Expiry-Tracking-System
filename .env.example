# ==============================================================================
# EXPIRY TRACKER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your local database and API credentials.

# --- PostgreSQL Database Infrastructure Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expiry_tracker
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Alternatively, specify a single combined PostgreSQL connection URL:
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/expiry_tracker

# Allow automatic fallback to SQLite (expiry_tracker.db) if PostgreSQL server is offline:
FALLBACK_TO_SQLITE=true

# --- Google Gemini AI API Configuration ---
# Obtain your free-tier API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Free-tier supports gemini-3.5-flash and gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# --- Lifespan Calculation Engine Parameters ---
# Days remaining threshold for 'NEAR EXPIRY' boundary (0 < Days <= Threshold)
EXPIRY_THRESHOLD_DAYS=30

# --- Alerting & Notification Broadcast Configuration ---
MANAGER_ALERT_EMAIL=inventory-manager@store.internal
ALERT_SENDER_EMAIL=alerts@inventory-system.internal
ALERT_LOG_FILE=alerts.log
